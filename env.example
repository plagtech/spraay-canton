# Spraay Canton — Environment Configuration
# Copy to .env and fill in values

# Canton JSON Ledger API (sandbox default)
CANTON_LEDGER_API_URL=http://localhost:7575
CANTON_ADMIN_API_URL=http://localhost:5012

# JWT token for authenticated Ledger API (production)
CANTON_JWT_TOKEN=

# Spraay operator party ID (allocated on first run in sandbox)
SPRAAY_OPERATOR_PARTY_ID=

# Canton user ID for command submission
CANTON_USER_ID=spraay-operator

# Network: localnet | devnet | testnet | mainnet
CANTON_NETWORK=localnet

# Spraay Protocol settings
SPRAAY_FEE_RATE=0.003
SPRAAY_MAX_BATCH_SIZE=100
SPRAAY_MAX_UTXO_TARGET=10
SPRAAY_GATEWAY_URL=https://gateway.spraay.app

# Daml package ID (set after first `dpm build`)
SPRAAY_DAML_PACKAGE_ID=

# Server
PORT=3100
HOST=0.0.0.0
LOG_LEVEL=info
