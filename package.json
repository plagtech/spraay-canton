{
  "name": "spraay-canton",
  "version": "0.1.0",
  "description": "Spraay Protocol batch payment infrastructure for Canton Network — UTXO-optimized batch transfers via the JSON Ledger API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "generate:api": "openapi-typescript http://localhost:7575/docs/openapi -o src/generated/ledger-api.d.ts",
    "sandbox": "dpm sandbox --json-api-port 7575 --dar .daml/dist/spraay-canton-0.1.0.dar",
    "daml:build": "dpm build",
    "daml:test": "dpm test",
    "test": "jest --config jest.config.js",
    "mcp:start": "ts-node src/mcp/server.ts"
  },
  "keywords": [
    "canton",
    "spraay",
    "batch-payments",
    "daml",
    "x402",
    "mcp",
    "token-standard",
    "cantonnetwork"
  ],
  "author": "Spraay Protocol (plagtech)",
  "license": "0BSD",
  "dependencies": {
    "openapi-fetch": "^0.12.0",
    "openapi-typescript": "^7.4.0",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "uuid": "^10.0.0",
    "winston": "^3.14.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "ts-node": "^10.9.0",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "@types/jest": "^29.5.0"
  },
  "engines": {
    "node": ">=18.20.0"
  }
}
